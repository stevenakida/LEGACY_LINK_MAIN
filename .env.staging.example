# Staging environment — mirrors production's DigitalOcean env-var shape,
# but runs entirely on your machine (localhost Postgres, no cloud services).
# Copy to .env to activate staging mode. Never commit .env itself.
#
# Production (DO app "legacylink-app") sets: ALLOWED_HOSTS, DEBUG,
# DATABASE_URL, SECRET_KEY, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD,
# FEEDBACK_NOTIFY_EMAIL, R2_* (DigitalOcean Spaces). Staging sets the same
# keys with local-safe values so behavior matches without touching prod.

SECRET_KEY=            # any random string; NOT the production key
DEBUG=False            # match production — catches DEBUG-only bugs locally
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://10.0.2.2:8000
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Local Postgres (same engine/major workflow as production's managed PG).
# Created by scripts/setup_staging_db (database: legacylink_staging).
DATABASE_URL=postgres://legacylink:legacylink@localhost:5432/legacylink_staging

# Email — leave EMAIL_HOST_USER blank so staging prints emails to the
# console instead of really sending them (prod uses Gmail SMTP).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FEEDBACK_NOTIFY_EMAIL=

# Media storage — leave R2_ACCESS_KEY_ID blank so staging uses local
# filesystem storage (prod uses DigitalOcean Spaces bucket
# legacy-link-production-media). Do NOT point staging at the prod bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# "Continue with Google" (optional in staging)
GOOGLE_OAUTH_CLIENT_ID=

# Media pipeline feature flags — prod leaves these unset (False). Flip them
# on here first when developing media features.
FEATURE_MEDIA_UPLOADS_ENABLED=False
FEATURE_VIDEO_MEDIA_ENABLED=False
FEATURE_DOCUMENT_MEDIA_ENABLED=False
