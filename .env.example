# Copy to .env and fill in real values locally. Never commit .env itself
# (it's gitignored) — this file documents the keys only, no real secrets.

SECRET_KEY=
DEBUG=True
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://legacy-link-main.onrender.com

# Feedback email notifications (Gmail SMTP). Leave EMAIL_HOST_USER blank to
# just print emails to the console instead of sending them.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
FEEDBACK_NOTIFY_EMAIL=

# Default/avatar media storage (Cloudflare R2 or DigitalOcean Spaces,
# S3-compatible). Leave R2_ACCESS_KEY_ID blank to use local filesystem
# storage instead (fine for local dev). This is PUBLIC-read storage — do
# not reuse it for anything private.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# "Continue with Google" (see config/views.py::google_login)
GOOGLE_OAUTH_CLIENT_ID=

# --- Media assets (Phase 1: private message/post attachment pipeline) ---
# Reuses the R2_* credentials above (same bucket, private prefixes, direct
# boto3 access — see media_assets/storage.py) rather than needing separate
# credentials. Leave R2_ACCESS_KEY_ID blank to use the local filesystem
# fallback (media_assets/storage.py::LocalMediaBackend) for local dev.
MEDIA_ASSETS_S3_REGION=us-east-1

# Upload/signed URL lifetimes (seconds).
MEDIA_UPLOAD_URL_TTL_SECONDS=600
MEDIA_SIGNED_URL_TTL_SECONDS=300

# Pilot size/format limits.
MEDIA_IMAGE_MAX_MB=10
MEDIA_VIDEO_MAX_MB=50
MEDIA_PDF_MAX_MB=10
MEDIA_VIDEO_MAX_DURATION_SECONDS=60
MEDIA_IMAGE_MAX_DIMENSION=2048
MEDIA_IMAGE_MAX_PIXELS=40000000

# How long an unattached/orphaned or terminally failed upload survives
# before `manage.py cleanup_media` purges it.
MEDIA_ORPHAN_RETENTION_HOURS=72

# Feature flags — all default False. Turn on FEATURE_MEDIA_UPLOADS_ENABLED
# to allow image uploads; FEATURE_VIDEO_MEDIA_ENABLED/FEATURE_DOCUMENT_MEDIA_ENABLED
# additionally gate video/PDF specifically (documents also require CLAMD_HOST
# below to be reachable, or every PDF fails closed regardless of this flag).
FEATURE_MEDIA_UPLOADS_ENABLED=False
FEATURE_VIDEO_MEDIA_ENABLED=False
FEATURE_DOCUMENT_MEDIA_ENABLED=False

# ClamAV (clamd) — NEW infrastructure, not currently provisioned anywhere in
# this project. Required for any PDF to ever reach a "clean"/downloadable
# state; leave blank to keep PDF sharing disabled (fails closed, see
# media_assets/scanning.py::NullScanner).
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15

# ffprobe/ffmpeg — NEW infrastructure, not currently provisioned anywhere in
# this project. Required for video uploads to pass duration/container
# validation; if the binaries aren't on PATH, video uploads fail closed.
# Only set these if ffprobe/ffmpeg live somewhere other than PATH.
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
